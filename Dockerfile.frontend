# pnpm 11 needs Node >= 22.13. Keep in step with .github/workflows/test.yml.
FROM node:22-alpine AS base

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
# `prisma generate` never opens the database; the real path is set at runtime.
ENV DATABASE_URL=file:/tmp/placeholder.db
RUN pnpm exec prisma generate

# --- Dev stage: next dev with hot reload ---
FROM base AS dev
EXPOSE 3001
ENV PORT=3001
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm exec next dev --hostname 0.0.0.0 --port 3001"]

# --- Prod stage: build and serve ---
FROM base AS prod
# Auth.js needs a secret to exist while Next collects page data. It is set for
# this command only, so the image carries no default and fails closed if the
# real secret is ever missing at runtime.
RUN NEXTAUTH_SECRET=build-placeholder pnpm build

# The standalone server looks for its static and public assets beside itself.
RUN cp -r .next/static .next/standalone/.next/static
RUN cp -r public .next/standalone/public

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
# The database is a SQLite file on the Fly volume (DATABASE_URL in fly.toml).
# Migrations and the admin seed run here at boot, from /app where the full
# node_modules lives: a Fly release command runs in a machine without the
# volume and could not reach the file. Both are no-ops when nothing changed.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node_modules/.bin/tsx prisma/seed-deploy.ts && exec node .next/standalone/server.js"]
