# Serving the production web app from this machine over the Fly private
# network. Copy to gpu-box.env (gitignored), fill in, then `make serve`.
# See the README, "Using the GPU box for compute".

# Same value as ML_API_KEY on peace-frontend.
PEACE_API_KEY=

# The production bucket, so uploads can be fetched. Same values as peace-ml.
PEACE_S3_BUCKET=
PEACE_S3_REGION=us-east-1
PEACE_AWS_ACCESS_KEY_ID=
PEACE_AWS_SECRET_ACCESS_KEY=

PEACE_DEBUG=false
PEACE_DEVICE=cuda
# Results of analyses run here live in this file; keep it between runs.
PEACE_JOB_DB_PATH=./data/jobs.db
PEACE_UPLOAD_DIR=./data/uploads
